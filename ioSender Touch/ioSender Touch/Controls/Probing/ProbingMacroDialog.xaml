<Window x:Class="ioSenderTouch.Controls.Probing.ProbingMacroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:probing="clr-namespace:ioSenderTouch.ViewModels.Probing"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance probing:ProbeMacroViewModel}"
        Title="ProbingMacroDialog" Height="375" Width="575"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"  WindowStartupLocation="Manual"
        FontFamily="{materialDesign:MaterialDesignFont}" WindowStyle="ToolWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5,0,0,0">
            <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="Name: "></Label>
            <TextBox Height="40" TextWrapping="Wrap" AcceptsReturn="True" HorizontalAlignment="Left" VerticalAlignment="Center" Width="250"
                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                     Text="{Binding MacroName, UpdateSourceTrigger=PropertyChanged}"></TextBox>

        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,0,0,0">
            <Label HorizontalAlignment="Center" Content="PreProbe Commands"></Label>
            <Border BorderThickness="2">
                <TextBox Height="125" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding PreMacroText, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,0,0">
            <Label HorizontalAlignment="Center" Content="PostProbe Commands"></Label>
            <Border BorderThickness="2">
                <TextBox TextWrapping="Wrap" AcceptsReturn="True" Height="125" Text="{Binding PostMacroText, UpdateSourceTrigger=PropertyChanged}"></TextBox>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
            <CheckBox Content="Single Use" VerticalAlignment="Center" Height=" 40" Width="100" FontSize="15" Margin="0,0,10,0" IsChecked="{Binding RunOnce, Mode=TwoWay, FallbackValue=true}"></CheckBox>
            <ComboBox Height="40" Width="175" VerticalAlignment="Center" SelectedIndex="{Binding SelectedItemIndex}" HorizontalAlignment="Center" DisplayMemberPath="Name"
                      SelectedItem="{Binding MacroSelectedItem}" Margin="0,0,10,0"
                      ItemsSource="{Binding Macros, UpdateSourceTrigger=PropertyChanged}"></ComboBox>
            <Button Height="40" Width="80" Content="Delete" VerticalAlignment="Center" Command="{Binding DeleteCommand}" ></Button>
        </StackPanel>
        <StackPanel Margin="5,0,0,5" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal">
            <Button Width="100" Height="35" Content="Clear" Margin="0,0,10,0" Command="{Binding ClearCommand}" ></Button>
            <Button Width="100" Content="Close" Margin="0,0,10,0" Command="{Binding CloseCommand}" ></Button>
            <Button Width="100"  Content="Add" Command="{Binding AddCommand }"  ></Button>
        </StackPanel>
    </Grid>
</Window>
