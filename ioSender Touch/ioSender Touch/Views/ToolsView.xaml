<UserControl x:Class="ioSenderTouch.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ioSenderTouch.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:ToolsViewModel, IsDesignTimeCreatable=True}"
             mc:Ignorable="d" 
             d:DesignHeight="515" d:DesignWidth="875">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0"  >
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="70"></RowDefinition>
            </Grid.RowDefinitions>
        <ListView   SelectedItem="{Binding SelectedTool}" Margin="10" FontSize="18" MinWidth="200" 
                      ItemsSource="{Binding ToolCollection}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToolNumber, StringFormat= Tool#: {0}}" 
                                   MinWidth="100" HorizontalAlignment="Center" Margin="2"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding X, StringFormat= X: {0}}" MinWidth="115" Margin="2"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Y, StringFormat= Y: {0}}"  MinWidth="115" Margin="2"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Z, StringFormat= Z: {0}}"  MinWidth="115" Margin="2"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
             
            </ListView>
            <StackPanel Grid.Row="1"  HorizontalAlignment="Center" VerticalAlignment="Center"  Orientation="Horizontal">
                <Button Height="50" Command="{Binding SaveToolOffsetsCommand}" Content="Save ToolTable" Margin="10,0"></Button>
                <Button Height="50" Command="{Binding RestoreToolOffsetsCommand}" Content="Restore ToolTable" Margin="10,0"></Button>
            </StackPanel>
        </Grid>
        <Grid Margin="50,15,0,0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,5,0,0" Grid.Row="0" Orientation="Horizontal">
                <Label MinHeight="30" FontSize="22" Content="{Binding SelectedTool.ToolNumber}" ContentStringFormat="Tool#: {0}" ></Label>
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3" >
                <Label FontSize="22" Content="X axis:"/>
                <TextBox FontSize="22" Text="{Binding Offset.X}" Width="75"/>
                <Button Content="Set" Command="{Binding SetOffsetCommand}" CommandParameter="X"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal"  Margin="0,3">
                <Label FontSize="22" Content="Y axis:"/>
                <TextBox FontSize="22" Text="{Binding Offset.Y}" Width="75"/>
                <Button Content="Set" Command="{Binding SetOffsetCommand}" CommandParameter="Y"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3" >
                <Label FontSize="22" Content="Z axis:"/>
                <TextBox FontSize="22" Text="{Binding Offset.Z}" Width="75"/>
                <Button Content="Set" Command="{Binding SetOffsetCommand}" CommandParameter="Z"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Margin="0,0,5,0" Content="Get Current" Command="{Binding GetCurrPosCommand}" />
                <Button Margin="0,0,5,0" Content="Clear All" Command="{Binding ClearAllCommand}" />
                <Button Content="Set All" Command="{Binding SetAllCommand}" />
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
